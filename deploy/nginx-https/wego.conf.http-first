# wego 首次签发证书用：放到 /etc/nginx/conf.d/wego.conf
# 前提：/etc/nginx/nginx.conf 的 http {} 里有 include /etc/nginx/conf.d/*.conf;
# 签完证书后，用 wego.conf 覆盖本文件。

# 单点登录
server {
    listen 80;
    server_name sso.xzyang.cn;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# 包装样机
