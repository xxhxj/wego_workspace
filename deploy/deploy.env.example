# 生产环境部署配置（示例）。复制为 deploy.env 后填写。
# 正式域名：把 your-domain.com 换成你的域名；DNS 需先解析到服务器。
BASE_DOMAIN=your-domain.com

# 可选：单独覆盖子域名；留空则自动使用 sso./mockup./cad./quiz./files.$BASE_DOMAIN
SSO_DOMAIN=
MOCKUP_DOMAIN=
CAD_DOMAIN=
QUIZ_DOMAIN=
FILES_DOMAIN=

# 首次可先用 0（HTTP）验证；DNS 和 80 端口就绪后改 1，脚本会调用 certbot。
ENABLE_TLS=0
LETSENCRYPT_EMAIL=

# MySQL（生产建议使用专用用户，不要用 root）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=wego_app
MYSQL_PASSWORD=change-me
SSO_DB=wego_sso
MOCKUP_DB=wego_mockup
QUIZ_DB=wego_quiz
MYSQL_TIMEZONE=+08:00

# MinIO
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=wego-mockup

# 浏览器访问图片/分享预览的地址；留空且 MINIO_PROXY=1 时自动使用 https://files.<域名>/wego-mockup
MINIO_PUBLIC_BASE=
# 1: 由 Nginx 的 files 子域反代 MinIO；0: 使用上面的 MINIO_PUBLIC_BASE
MINIO_PROXY=1
MINIO_PROXY_TARGET=http://127.0.0.1:9000

# 内部 SSO 接口地址（同一台服务器保持 127.0.0.1 即可）
SSO_API_URL=http://127.0.0.1:3001
JWT_EXPIRES=12h
QUIZ_TOKEN_SECRET=change-me-too
MYSQL_TIMEZONE=+08:00

# 第一次空库部署设为 1；已有数据请保持 0，避免重置演示账号
RUN_SEED=0
# 1: 即使 node_modules 已存在也重新 npm ci
FORCE_INSTALL=0
PM2_CMD=pm2
